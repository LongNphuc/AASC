# Cổng HTTP của ứng dụng. ngrok phải trỏ về đúng cổng này.
PORT=3000
# Tên miền công khai (ngrok) dùng cho /install và /webhook/jotform
PUBLIC_URL=https://thirty-overreact-disperser.ngrok-free.dev

# Bitrix24 OAuth (File 2): lấy ở form "Ứng dụng cục bộ" trên Bitrix24
BITRIX24_DOMAIN=b24-4totiv.bitrix24.vn
CLIENT_ID=
CLIENT_SECRET=
# (Tùy chọn) ID mẫu requisite dùng khi tạo thông tin ngân hàng. Để trống thì tự dò.
BITRIX24_REQUISITE_PRESET_ID=

# Khóa bảo vệ endpoint của chính ứng dụng (File 2), gửi qua header x-api-key
API_KEY=

# Bitrix24 webhook vào (File 1), dạng https://<portal>/rest/<user_id>/<mã>/
BITRIX24_WEBHOOK_URL=

# Jotform (File 1)
JOTFORM_API_KEY=
JOTFORM_FORM_ID=262753749396070
# Đổi thành https://eu-api.jotform.com nếu tài khoản Jotform ở vùng EU
JOTFORM_API_BASE_URL=https://api.jotform.com

# Lưu trữ và log
DATABASE_PATH=data/app.sqlite
LOG_DIR=logs
# Thời gian chờ tối đa (ms) cho mỗi lệnh gọi API ra ngoài
HTTP_TIMEOUT_MS=10000
