# Cổng HTTP và WebSocket (mặc định 3001, khác cổng 3000 của phần integration)
PORT=3001

# Lưu trữ và log
DATABASE_PATH=data/game.sqlite
LOG_DIR=logs

# Khóa ký JWT. Để trống: sinh khóa ngẫu nhiên mỗi lần khởi động (token cũ mất hiệu lực khi khởi động lại).
# Tạo khóa: openssl rand -hex 32
JWT_SECRET=
# Thời hạn token: 1d, 12h, 30m...
JWT_EXPIRES_IN=1d

# Số vòng băm bcrypt (4-15), 10 là mức thông dụng
BCRYPT_ROUNDS=10
